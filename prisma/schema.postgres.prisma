// Production Postgres schema. Structurally identical to the local SQLite
// schema (prisma/schema.prisma); only the datasource differs. The Dockerfile
// and prod scripts point at this file explicitly:
//   prisma generate --schema=prisma/schema.postgres.prisma

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Card {
  id            String    @id @default(cuid())
  playerName    String
  year          Int
  setName       String
  cardNumber    String
  variant       String    @default("Base")
  sport         String
  searchQuery   String?
  lastFetchedAt DateTime?
  sales         Sale[]
  listings      Listing[]

  @@unique([playerName, year, setName, cardNumber, variant])
}

model Sale {
  id         String   @id @default(cuid())
  cardId     String
  card       Card     @relation(fields: [cardId], references: [id])
  grade      String
  price      Float
  soldAt     DateTime
  source     String   @default("mock")
  externalId String?  @unique

  @@index([cardId, grade, soldAt])
}

model Listing {
  id         String   @id @default(cuid())
  cardId     String
  card       Card     @relation(fields: [cardId], references: [id])
  grade      String
  askPrice   Float
  title      String
  listedAt   DateTime
  source     String   @default("mock")
  url        String   @default("")
  active     Boolean  @default(true)
  externalId String?  @unique

  @@index([cardId, grade, active])
}
