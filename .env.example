# Copy to .env for local dev. NEVER commit real values — .env is gitignored.

# --- database ---
# Local dev (SQLite, zero-config):
DATABASE_URL="file:./dev.db"
# Production (Postgres — set on the platform, not in git). The connection_limit
# and pool_timeout params tune Prisma's pool so concurrent scheduler + web
# requests can't exhaust the DB:
# DATABASE_URL="postgresql://user:pass@host:5432/db?connection_limit=20&pool_timeout=20"

# --- data mode ---
# true  = seeded mock market moves every 10 min (no network)
# false = live eBay + MySlabs scraping
MOCK_MODE=true

# --- scheduler tuning (all optional) ---
# REFRESH_INTERVAL_MS=600000     # 10 minutes
# EBAY_REQUEST_DELAY_MS=2000     # politeness delay between eBay fetches
# EBAY_TIMEOUT_MS=15000          # per-request hard timeout
# MYSLABS_REQUEST_DELAY_MS=2500
# MYSLABS_TIMEOUT_MS=15000
# MYSLABS_ENABLED=false          # disable an entire source without a code change
